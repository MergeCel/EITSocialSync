APP_NAME=SocialSync
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

FRONTEND_URL=http://localhost:5173
# Produksi: ganti dengan domain HTTPS Anda (tanpa skema), mis. app.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Produksi: aktifkan cookie Secure dan nonaktifkan debug
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# Buffer adalah gateway publikasi aktif. Personal API key setiap pengguna
# disimpan terenkripsi di database lewat: php artisan socialsync:user-provision
SOCIAL_PROVIDER=buffer
BUFFER_API_URL=https://api.buffer.com
BUFFER_MANAGE_URL=https://publish.buffer.com/channels
BUFFER_MAX_CHANNELS=3
# Path CA bundle untuk instalasi PHP yang tidak memiliki certificate store bawaan.
BUFFER_CA_BUNDLE=C:/php/extras/ssl/cacert.pem

# ============================================================
# GOOGLE DRIVE OAUTH
# Enable Google Drive API dan tambahkan scope:
# openid, email, profile, drive.readonly
# Authorized redirect URI:
# http://localhost:8000/api/auth/google/callback
# Produksi: https://domain-anda.com/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Opsional pada Windows jika PHP tidak menemukan root CA sistem.
GOOGLE_CA_BUNDLE=C:/php/extras/ssl/cacert.pem

META_GRAPH_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
